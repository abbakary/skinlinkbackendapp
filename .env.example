# Database Configuration (SQLite by default, or Postgres URL e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./data/skinlink.db

# JWT & Security
SECRET_KEY=skinlink-dev-secret-change-in-production

# Public origin of this API so case images load on the web app in production.
# Railway: https://your-service.up.railway.app  (or rely on RAILWAY_PUBLIC_DOMAIN)
PUBLIC_BASE_URL=

# Optional: persistent volume path on Railway so uploads survive redeploys
# UPLOAD_DIR=/data/uploads

# Platform Provider Account Initial Credentials
PLATFORM_ADMIN_EMAIL=ops@skinlink.io
PLATFORM_ADMIN_PASSWORD=platform123

# Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TEMPERATURE=0.2
